cabal-version:      3.0
name:               plexus-protocol
version:            0.6.0.0
synopsis:           Plexus RPC protocol types and client
license:            MIT
author:
maintainer:
build-type:         Simple

library
  exposed-modules:
    Plexus.Client
    Plexus.Client.Pool
    Plexus.Transport
    Plexus
    Plexus.Types
    Plexus.RemoteError
    Plexus.Schema
    Plexus.Schema.Cache
    Plexus.Schema.Recursive
  build-depends:
    base ^>=4.17 || ^>=4.18 || ^>=4.19,
    aeson >= 2.0,
    aeson-casing >= 0.2,
    text >= 2.0,
    bytestring >= 0.11,
    case-insensitive >= 1.2,
    containers >= 0.6,
    websockets >= 0.13,
    network >= 3.1,
    async >= 2.2,
    stm >= 2.5,
    streaming >= 0.2,
    directory >= 1.3,
    filepath >= 1.4,
    time >= 1.9,
    resource-pool >= 0.4
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
    DeriveGeneric
    DeriveAnyClass
    DerivingStrategies
    GeneralizedNewtypeDeriving
    LambdaCase
    RecordWildCards

-- Golden tests against the plexus 0.7 conformance fixture (RETURNS-7), read
-- by sibling path from ../plexus-macros/fixtures/conformance/expected/.
test-suite plexus-protocol-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:
    base,
    plexus-protocol,
    aeson,
    bytestring,
    containers,
    directory,
    filepath,
    hspec >= 2.7,
    text
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
    LambdaCase
  ghc-options:      -Wall
